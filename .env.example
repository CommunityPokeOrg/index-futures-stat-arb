# Copy to .env and fill in real values. Never commit .env.

# Databento API key (only needed for real CME futures data)
DATABENTO_API_KEY=

# Data source used by load_prices(): "yfinance" or "databento"
DATA_SOURCE=yfinance

# Databento dataset for CME Globex futures
DATABENTO_DATASET=GLBX.MDP3

# The offline ingestion CLI uses deterministic synthetic fixtures instead.
